{
  "name": "dsh-codex-cli",
  "version": "0.2.2",
  "author": "zxbingoo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zxbingoo/dsh-codex-cli.git"
  },
  "homepage": "https://github.com/zxbingoo/dsh-codex-cli#readme",
  "bugs": {
    "url": "https://github.com/zxbingoo/dsh-codex-cli/issues"
  },
  "description": "Connect DeepSeek Harness to Codex CLI using its existing configuration and authentication, with Harness-owned tools.",
  "keywords": [
    "deepseek-harness",
    "harness",
    "codex",
    "codex-cli",
    "llm",
    "plugin"
  ],
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./bundle.yml": "./bundle.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": "0.2.1-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./bundle.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "files": [
    "client.js",
    "controller.mjs",
    "config.mjs",
    "index.mjs",
    "adapter.mjs",
    "rpc.mjs",
    "runtime.mjs",
    "bundle.yml",
    "isolation/isolation.mjs",
    "isolation/models.json",
    "isolation/test-isolation.mjs",
    "test/*.test.mjs",
    "test-live.mjs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "third-party/*"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:live": "node test-live.mjs",
    "test:isolation": "node isolation/test-isolation.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
